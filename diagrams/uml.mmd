classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +String name
        +List~Pet~ petsOwned
        +addTask(task: Task, planner: Planner) void
        +modifyTask(taskId: String, updatedTask: Task, planner: Planner) void
        +provideTaskData() Map
    }

    class Pet {
        +String name
        +int age
        +String healthCondition
        +String species
        +getName() String
        +setName(name: String) void
        +getAge() int
        +setAge(age: int) void
        +getHealthCondition() String
        +setHealthCondition(condition: String) void
        +getSpecies() String
        +setSpecies(species: String) void
    }

    class Task {
        +String taskId
        +String activityName
        +String description
        +String priority
        +String constraint
        +String time
        +getInfo() Map
    }

    class Planner {
        +List~Task~ tasks
        +addTask(task: Task) void
        +removeTask(taskId: String) void
        +selectTasks(constraint: String) List~Task~
        +organizeTasks(priority: String) List~Task~
        +getTasks() List~Task~
    }

    Owner "1" --> "1..*" Pet : owns
    Owner "1" --> "1" Planner : manages
    Planner "1" o-- "0..*" Task : stores
    Pet "1" -- "0..*" Task : associated with
